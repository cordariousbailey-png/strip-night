rules_version = '2';
// Strip Night ghost races. Anyone signed in (anonymous is fine) can read ghosts.
// A player can only write their own ghost (document id = their user id), one per race class,
// and only in the expected shape and size.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{col}/{uid} {
      allow read: if col.matches('ghosts_[a-z0-9]+') && request.auth != null;
      allow create, update: if col.matches('ghosts_[a-z0-9]+')
        && request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'et', 'mph', 'carName', 'data', 'tr', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 16
        && request.resource.data.et is number && request.resource.data.et > 3 && request.resource.data.et < 40
        && request.resource.data.mph is number
        && request.resource.data.carName is string && request.resource.data.carName.size() <= 40
        && request.resource.data.data is string && request.resource.data.data.size() < 8000
        && request.resource.data.tr is string && request.resource.data.tr.size() < 120000
        && request.resource.data.at is timestamp;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
